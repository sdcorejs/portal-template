{
  "name": "portal-template",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 2208",
    "test": "ng test",
    "plop:module": "npx plop module",
    "plop:entity": "npx plop entity",
    "plop:example:product": "npx plop entity -- --lib examples --name product --label \"sản phẩm\" --detailType page --importExcel no",
    "fetch": "node sync-submodules.js",
    "build:qc": "ng build --configuration dev",
    "deploy:firebase": "firebase deploy --only hosting:cs-portal-template",
    "watch": "ng build --watch --configuration development",
    "build": "ng build --configuration=dev",
    "build-dev": "ng build --configuration=dev",
    "build-qc": "ng build --configuration=qc",
    "build-uat": "ng build --configuration=uat",
    "build-prod": "ng build --configuration=prod",
    "lint": "ng lint",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "storybook": "ng run portal-template:storybook",
    "build-storybook": "ng run portal-template:build-storybook",
    "export:catalog": "node scripts/export-page-catalog.mjs",
    "check:catalog": "node scripts/export-page-catalog.mjs --check",
    "test:catalog": "node --test scripts/export-page-catalog.test.mjs",
    "test:e2e": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.6",
    "@angular/cdk": "22.1.6",
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/material": "22.1.6",
    "@angular/material-date-fns-adapter": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/platform-browser-dynamic": "22.1.6",
    "@angular/router": "22.1.6",
    "@sdcorejs/angular": "22.2.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^11.1.0",
    "zone.js": "~0.15.0",
    "@sdcorejs/utils": "1.1.4"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.6",
    "@types/jasmine": "~5.1.0",
    "@types/uuid": "^7.0.0",
    "angular-eslint": "22.5.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "plop": "^4.0.1",
    "prettier": "^3.8.1",
    "prettier-eslint": "^16.4.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "@angular-devkit/build-angular": "22.1.7",
    "storybook": "10.6.0",
    "@storybook/angular": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@playwright/test": "1.63.0"
  },
  "overrides": {
    "minimatch": "^9.0.7",
    "picomatch": "^4.0.4"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  }
}
